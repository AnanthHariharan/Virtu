# ── Supabase ────────────────────────────────────────────────────────
# From your project's API settings. The anon key is safe in the client:
# Row Level Security is on and every policy is scoped to auth.uid().
#
# Both may be left blank. Virtu runs entirely against IndexedDB with no
# database configured — sync simply no-ops.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Jev (TypeSafe) ──────────────────────────────────────────────────
# Server-side only — never prefix with NEXT_PUBLIC_. Leave blank and the
# inbox simply never proposes anything. Captures are only sent once you
# switch Jev on in Settings.
TYPESAFE_API_KEY=
# Pin a versioned model once thresholds are tuned against it (jev-1.13.0).
TYPESAFE_DEFAULT_MODEL=
# With no Supabase configured, the route refuses in production unless this
# is 1. Do not set it on a public deployment.
JEV_ALLOW_ANON=
